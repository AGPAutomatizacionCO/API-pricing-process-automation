APP_NAME=AGP Pricing Process API
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=5000

# Azure App Service Easy Auth
# En Azure, la identidad llega por headers X-MS-*.
# En local se puede habilitar modo desarrollo para simular usuario.
EASY_AUTH_ENABLED=true
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_EMAIL=miuser@agpglass.com
LOCAL_AUTH_NAME=Usuario Local

# MSAL / Entra ID (la API valida el JWT Bearer; roles = app roles asignados a grupos)
# Al migrar totalmente a MSAL: MSAL_AUTH_ENABLED=true y EASY_AUTH_ENABLED=false
# (con Easy Auth apagado los headers X-MS-* se ignoran porque serian falsificables).
MSAL_AUTH_ENABLED=false
MSAL_TENANT_ID=
MSAL_CLIENT_ID=
MSAL_REQUIRED_SCOPE=access_as_user
MSAL_ROLE_ADMIN=Pricing.Admin
MSAL_ROLE_ANALYST=Pricing.Analyst
MSAL_ROLE_VIEWER=Pricing.Viewer

# SQL Server / Azure SQL
SQL_SERVER=
SQL_DATABASE=
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUSTED_CONNECTION=false
SQL_USERNAME=
SQL_PASSWORD=

# CORS
# En producción agregar solo los dominios reales permitidos.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Access policy
ACCESS_POLICY_ENABLED=true
ADMIN_USERS=miuser@agpglass.com
ANALYST_USERS=
VIEWER_USERS=

# Future: Microsoft Entra groups
ADMIN_GROUPS=
ANALYST_GROUPS=
VIEWER_GROUPS=

# Logging
LOG_LEVEL=INFO
AUDIT_LOG_ENABLED=true